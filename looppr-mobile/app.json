{
  "expo": {
    "name": "Looppr",
    "slug": "looppr-mobile",
    "scheme": "looppr",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.getlooppr.mobile"
    },
    "android": {
      "package": "com.getlooppr.mobile",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/looppr-mark.png",
          "resizeMode": "contain",
          "backgroundColor": "#ECEAF6"
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/looppr-mark.png",
          "color": "#7C73E6"
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Looppr uses your location to show nearby pickup windows and driver routes."
        }
      ],
      "expo-secure-store",
      "expo-font",
      [
        "expo-image-picker",
        {
          "cameraPermission": "Looppr uses your camera to confirm bag pickups and deliveries with a photo."
        }
      ],
      [
        "react-native-maps",
        {
          "androidGoogleMapsApiKey": ""
        }
      ],
      "expo-image",
      [
        "@stripe/stripe-react-native",
        {
          "merchantIdentifier": "merchant.com.getlooppr.mobile",
          "enableGooglePay": false
        }
      ]
    ],
    "extra": {
      "apiBaseUrl": "https://buck-innovations-martha-cheapest.trycloudflare.com/api",
      "useMockApi": true,
      "useMockCustomerAuth": false,
      "useMockBusinessAuth": false,
      "useMockPartnerAuth": false,
      "useMockDriverAuth": false,
      "useMockCustomerOrders": false,
      "useMockDriverOps": false,
      "useMockPartnerOps": false,
      "useMockBusinessOps": false,
      "googleMapsApiKey": "",
      "stripePublishableKey": "pk_live_51LfGPXEH073JFgHUF57yUF926jQlJGyqZDYSOQaeHE2sWcGcIrH0bT9RoW9BGi0e0FxXPx0jOSpIbZXqbR8rqUHl00vgZKgAi0",
      "router": {},
      "eas": {
        "projectId": "a8bf49f9-8fe6-45f0-9d02-0e78c759ded2"
      }
    },
    "owner": "sayflux04"
  }
}
